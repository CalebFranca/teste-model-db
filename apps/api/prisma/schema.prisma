generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id        String   @id @default(uuid())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model IgaoTeste {
  id String @id @default(uuid()) @db.Uuid
  idade Int

  @@map("igao_teste")
}
